---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../pbn-config';
---

<BaseLayout title="Page Not Found" description="Sorry, the page you are looking for does not exist." noindex={true}>
  <div class="text-center py-16">
    <h1 class="text-9xl font-bold text-slate-200 font-heading">404</h1>
    <h2 class="text-2xl font-bold text-slate-900 mt-4 mb-4">Page Not Found</h2>
    <p class="text-slate-600 mb-8 max-w-md mx-auto">Sorry, but the page you are looking for does not exist or has been moved.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/" class="inline-flex items-center px-6 py-3 bg-primary-600 text-white font-medium rounded-xl hover:bg-primary-700 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
        Home Page
      </a>
      <a href="/blog/" class="inline-flex items-center px-6 py-3 bg-white text-slate-700 border border-slate-300 font-medium rounded-xl hover:bg-slate-50 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
        All Articles
      </a>
    </div>
  </div>
</BaseLayout>
