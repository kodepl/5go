---
import { SITE_CONFIG, LAYOUT_CONFIG } from '../pbn-config';

const currentYear = new Date().getFullYear();
---

{LAYOUT_CONFIG.footerStyle !== 'none' && (
  <footer class={`${LAYOUT_CONFIG.colors.footerBg} ${LAYOUT_CONFIG.colors.footerText} mt-16`}>
    {LAYOUT_CONFIG.footerStyle === 'standard' && (
      <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <h3 class="text-white font-bold text-lg mb-4 font-heading">{SITE_CONFIG.name}</h3>
            <p class="text-slate-400 text-sm leading-relaxed max-w-md">
              {SITE_CONFIG.description}
            </p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4">Categories</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/tag/self-improvement/" class="text-slate-400 hover:text-white transition-colors">Self Improvement</a></li>
              <li><a href="/tag/wellness/" class="text-slate-400 hover:text-white transition-colors">Wellness & Health</a></li>
              <li><a href="/tag/productivity/" class="text-slate-400 hover:text-white transition-colors">Productivity</a></li>
              <li><a href="/tag/lifestyle/" class="text-slate-400 hover:text-white transition-colors">Lifestyle</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4">Contact</h4>
            <p class="text-slate-400 text-sm">{SITE_CONFIG.organization.email}</p>
          </div>
        </div>
        <div class="border-t border-slate-800 mt-8 pt-8 text-center text-sm text-slate-500">
          <p>&copy; {currentYear} {SITE_CONFIG.organization.name}. All rights reserved.</p>
        </div>
      </div>
    )}
  </footer>
)}
